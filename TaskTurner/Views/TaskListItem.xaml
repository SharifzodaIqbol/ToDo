<UserControl x:Class="TaskTurner.Views.TaskListItem"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:TaskTurner.Views"
             mc:Ignorable="d" 
             d:DesignHeight="145" d:DesignWidth="435">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="38"/>
            <RowDefinition Height="1*"/>
            <RowDefinition Height="40"/>
        </Grid.RowDefinitions>

        <!--Title-->
        <TextBlock Text="Title"
                   Style="{StaticResource Title}"
                   Foreground="{StaticResource TaskListTitle}"
                   Margin="20 0"
                   VerticalAlignment="Center"/>
        <Border CornerRadius="3" Background="{StaticResource PlaceHolderText}"
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                Height="23"
                Padding="40 0"
                Margin="0 0 20 0">
            <TextBlock Text="Importance"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Center"/>
        </Border>
        <!--Importance Badge-->
        <!--Description-->
        <TextBlock Text="Title dfjdgjdfbbhjdgf dfgbhdfgjdg dfgjb"
                   TextWrapping="Wrap"
                   Grid.Row="1"
                   Margin="20 0 5 0"
                   Foreground="{StaticResource TaskListDescriptionUserText}">
        </TextBlock>
        <!--Due Date-->
        <TextBlock Text="16/06/2025"
                   Grid.Row="2"
                   VerticalAlignment="Center"
                   Margin="20 0"
                   Foreground="{StaticResource TaskListDescriptionUserText}"/>

    </Grid>
</UserControl>
