<Window x:Class="TaskTurner.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:TaskTurner"
        xmlns:vm="clr-namespace:TaskTurner.ViewModels"
        mc:Ignorable="d"
        Title="MainWindow" Height="832" Width="1280"
        MinWidth="1150" MinHeight="500"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <Storyboard x:Key="Solid On Load">
            <DoubleAnimation Storyboard.TargetName="MainGrid" 
                             Storyboard.TargetProperty="Opacity" 
                             From="0.2" To="1.0" Duration="0:0:1">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <ThicknessAnimation Storyboard.TargetName="MainGrid"
                                Storyboard.TargetProperty="Margin" 
                                From="0,50,0,0" To="0,0,0,0" Duration="0:0:1.5">
                <ThicknessAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut"/>
                </ThicknessAnimation.EasingFunction>
            </ThicknessAnimation>
        </Storyboard>
    </Window.Resources>
    <Grid x:Name="MainGrid" Opacity="1" Margin="0">
        <Grid.Triggers>
            <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                <BeginStoryboard Storyboard="{StaticResource Solid On Load}"/>
            </EventTrigger>
        </Grid.Triggers>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="80" />
            <ColumnDefinition Width="435" />
            <ColumnDefinition Width="1*" />
            <ColumnDefinition Width="140" />
        </Grid.ColumnDefinitions>

        <Rectangle Fill="{StaticResource AccentDark}"/>
        <StackPanel Margin="10 15 10 10">
            <!--ListIcon-->
            <Button Style="{StaticResource TaskManagerButton}" Margin="0 0 0 10" Background="{StaticResource AccentDark}">
                <Viewbox Width="35" Height="35">
                    <Path Data="{StaticResource ListIcon}" Fill="White"/>
                </Viewbox>
            </Button>

            <Button Style="{StaticResource TaskManagerButton}" Margin="0 0 0 20" Background="{StaticResource AccentDark}">
                <Viewbox Width="35" Height="35">
                    <Path Data="{StaticResource TickIcon}" Stroke="White" StrokeThickness="2.8"/>
                </Viewbox>
            </Button>

            <Button Style="{StaticResource TaskManagerButton}" Background="{StaticResource AccentDark}">
                <Viewbox Width="35" Height="35">
                    <Path Data="{StaticResource TimerIcon}" Fill="White"/>
                </Viewbox>
            </Button>
        </StackPanel>
        <Rectangle Fill="{StaticResource TaskListBackground}" Grid.Column="1"/>
        <!--Task List Grid-->

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="68" />
                <RowDefinition Height="50" />
                <RowDefinition Height="1*" />
            </Grid.RowDefinitions>

            <!-- Заголовок и кнопка -->
            <Label Style="{StaticResource Heading1}" Content="Задачи"/>
            <Button Style="{StaticResource RoundAccentButton}" 
            HorizontalAlignment="Right"
            VerticalAlignment="Center"
            Height="45"
            Width="45"
            Margin="0 0 20 0"
            Command="{Binding IOpenNewWindow}">
                <Viewbox Width="22.5" Height="22.5" 
                 VerticalAlignment="Center" 
                 HorizontalAlignment="Center">
                    <Path Data="{StaticResource NewTaskIcon}" 
                  Fill="{StaticResource OnAccent}"/>
                </Viewbox>
            </Button>

            <!-- Поиск -->
            <TextBox x:Name="TaskSearchBox"
                 Style="{StaticResource TaskListSearchBox}" 
                 Grid.Row="1"
                 Margin="15 0"
                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}">
                <TextBox.InputBindings>
                    <KeyBinding Key="Enter" Command="{Binding FilterTasksCommand}"/>
                </TextBox.InputBindings>
            </TextBox>
            <Label IsHitTestVisible="False"
                   Grid.Row="1" 
                   Content="Поиск задач..."
                   VerticalContentAlignment="Center"
                   Margin="35 0 15 0"
                   Foreground="{StaticResource Borders}"
                   Visibility="{Binding Text.IsEmpty, ElementName=TaskSearchBox, Converter={StaticResource BooleanToVisibilityConverter}}"/>
            <Button Style="{StaticResource SearchButton}"
                    Grid.Row="1"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Margin="0 0 40 0"
                    Padding="7"
                    Background="White"
                    BorderBrush="Transparent"
                    Height="40" 
                    Width="40" Cursor="Hand">
                <Viewbox Width="16" Height="16" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Path Data="{StaticResource SearchIcon}" Fill="{StaticResource Borders}"/>
                </Viewbox>
            </Button>
            <Button Style="{StaticResource SearchButton}"
                    Grid.Row="1"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Margin="0 0 80 8"
                    Command="{Binding ClearSearchCommand}">
                <Viewbox Width="16" Height="16">
                    <Path Data="{StaticResource CloseIcon}" Fill="{StaticResource Borders}"/>
                </Viewbox>
            </Button>
            <ListView x:Name="UserTasksListView"
                      ItemsSource="{Binding FilteredTasksView}"
                      SelectedItem="{Binding SelectedTask}"
                      Grid.Row="2"
                      Margin="15"
                      Background="#FFF5F7FA"
                      BorderThickness="0"
                      HorizontalContentAlignment="Stretch">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Border CornerRadius="8" 
                                Margin="0 5"
                                BorderBrush="#FFD1C4E9"
                                BorderThickness="1 1 1 4"
                                Background="#FFF3E5F5">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="15" ShadowDepth="1" Opacity="0.12" Color="#7B1FA2"/>
                            </Border.Effect>
                            <Grid Margin="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <CheckBox VerticalAlignment="Center"
                                          IsChecked="{Binding IsCompleted, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          Command="{Binding DataContext.ICompleteTask, RelativeSource={RelativeSource AncestorType=ListView}}"
                                          CommandParameter="{Binding}"/>
                                <StackPanel Grid.Column="1" Margin="10 0">
                                    <TextBlock Text="{Binding Title}" 
                                                FontWeight="Bold"
                                                Foreground="#FF4A148C"
                                                FontSize="18"/>
                                    <TextBlock Text="{Binding Description}"
                                                Foreground="#FF757575"
                                                FontSize="15"/>
                                </StackPanel>
                                <TextBlock Grid.Column="2">
                        <Run Text="Дата" Foreground="#888888" FontSize="10"/>
                        <LineBreak/>
                        <Run Text="{Binding CurrentDate, StringFormat='{}{0:dd.MM.yyyy}'}" FontSize="12"/>
                        <LineBreak/>
                        <Run Text="Время" Foreground="#888888" FontSize="10"/>
                        <LineBreak/>
                        <Run Text="{Binding CurrentDate, StringFormat='{}{0:HH:mm}'}" FontSize="12"/>
                                </TextBlock>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>
        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="450"/>
                <RowDefinition Height="1*"/>
                <RowDefinition Height="10"/>
            </Grid.RowDefinitions>
            <Grid Margin="10 0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="80"/>
                    <RowDefinition Height="1*"/>
                    <RowDefinition Height="30"/>
                </Grid.RowDefinitions>
                <TextBlock Text="Список задач"
                           Style="{StaticResource Title}"
                           VerticalAlignment="Center"/>
                <ScrollViewer Grid.Row="1"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              Margin="0 0 0 15">
                    <ListView ItemsSource="{Binding UserTasks}"
                              SelectedItem="{Binding SelectedTask}"
                              Grid.Row="2"
                              Margin="15"
                              Background="#FFF5F7FA"
                              BorderThickness="0"
                              HorizontalContentAlignment="Stretch">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Border CornerRadius="8" 
                                        Margin="0 5"
                                        BorderBrush="#FFD1C4E9"
                                        BorderThickness="1 1 1 4"
                                        Background="#FFF3E5F5">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="15" ShadowDepth="1" Opacity="0.12" Color="#7B1FA2"/>
                                    </Border.Effect>
                                    <Grid Margin="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <CheckBox VerticalAlignment="Center"
                                                  IsChecked="{Binding IsCompleted, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                  Command="{Binding DataContext.ICompleteTask, RelativeSource={RelativeSource AncestorType=ListView}}"
                                                  CommandParameter="{Binding}"/>
                                        <StackPanel Grid.Column="1" Margin="10 0">
                                            <TextBlock Text="{Binding Title}" 
                                                    FontWeight="Bold"
                                                    Foreground="#FF4A148C"
                                                    FontSize="18"/>
                                            <TextBlock Text="{Binding Description}"
                                                    Foreground="#FF757575"
                                                    FontSize="15"/>
                                        </StackPanel>
                                        <TextBlock Grid.Column="2">
                                            <Run Text="Дата" Foreground="#888888" FontSize="10"/>
                                            <LineBreak/>
                                            <Run Text="{Binding CurrentDate, StringFormat='{}{0:dd.MM.yyyy}'}" FontSize="12"/>
                                            <LineBreak/>
                                            <Run Text="Время" Foreground="#888888" FontSize="10"/>
                                            <LineBreak/>
                                            <Run Text="{Binding CurrentDate, StringFormat='{}{0:HH:mm}'}" FontSize="12"/>
                                        </TextBlock>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </ScrollViewer>
                <Grid Grid.Row="2">
                    <Button Style="{StaticResource DeleteButton}"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        Content="Удалить"
                        Margin="80 0 0 0"
                        Command="{Binding IDeleteTask}"
                        CommandParameter="{Binding SelectedTask}"/>

                    <Button Style="{StaticResource EditButton}"
                        HorizontalAlignment="Right"
                        Margin="0 0 80 0"
                        VerticalAlignment="Center"
                        Command="{Binding IEditTask}"
                        CommandParameter="{Binding SelectedTask}"
                        Content="Редактировать"/>
                </Grid>
            </Grid>
            <!--Check List-->
            <Grid Grid.Row="1" Margin="0 10 0 0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="50"/>
                    <RowDefinition Height="1*"/>
                </Grid.RowDefinitions>

                <TextBlock Style="{StaticResource Title}"
                           Text="Список выполненных задач"
                           VerticalAlignment="Center"
                           Margin="20 5 0 0"/>

                <ListView ItemsSource="{Binding CompletedTasks}"
                          Background="Transparent"
                          BorderThickness="0"
                          Grid.Row="1">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Border CornerRadius="8" 
                                    Margin="0 5" 
                                    Background="#FFF1F8E9"
                                    BorderBrush="#FFC8E6C9"
                                    BorderThickness="1">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="10" 
                                          ShadowDepth="1" 
                                          Opacity="0.1" 
                                          Color="#FF4CAF50"/>

                                </Border.Effect>
                                <Grid Margin="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <CheckBox VerticalAlignment="Center"
                                              IsChecked="{Binding IsCompleted, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                              Command="{Binding DataContext.ICompleteTask, RelativeSource={RelativeSource AncestorType=ListView}}"
                                              CommandParameter="{Binding}"
                                              Style="{StaticResource MaterialDesignCheckBox}"
                                              Foreground="#FF4CAF50">

                                        <CheckBox.Content>
                                            <TextBlock Text="✓" 
                                                       FontSize="16"
                                                       Margin="5 0 0 0"
                                                       Foreground="#FF4CAF50"
                                                       Visibility="{Binding IsCompleted, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                        </CheckBox.Content>
                                    </CheckBox>

                                    <StackPanel Grid.Column="1" Margin="10 0">
                                        <TextBlock Text="{Binding Title}" 
                                           FontWeight="SemiBold"
                                           Foreground="#FF2E7D32"
                                           TextDecorations="Strikethrough"/>
                                        <TextBlock Text="{Binding Description}" 
                                           TextWrapping="Wrap"
                                           Foreground="#FF81C784"
                                           FontStyle="Italic"
                                           TextDecorations="Strikethrough"/>
                                    </StackPanel>


                                    <StackPanel Grid.Column="2" HorizontalAlignment="Right">
                                        <TextBlock Text="Выполнено:"
                                       Foreground="#FFA5D6A7"
                                       FontSize="10"/>
                                        <TextBlock Text="{Binding CompletionDate, StringFormat='{}{0:dd.MM.yyyy}'}"
                                       Foreground="#FF4CAF50"
                                       FontSize="12"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </Grid>
        <Rectangle Fill="{StaticResource TaskStatusBackground}" Grid.Column="3"/>
    </Grid>
</Window>