<Window x:Class="TaskTurner.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:TaskTurner"
        xmlns:vm="clr-namespace:TaskTurner.ViewModels"
        mc:Ignorable="d"
        Title="MainWindow" Height="832" Width="1280"
        MinWidth="1150" MinHeight="500"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <Storyboard x:Key="Solid On Load">
            <DoubleAnimation Storyboard.TargetName="MainGrid" 
                             Storyboard.TargetProperty="Opacity" 
                             From="0.2" To="1.0" Duration="0:0:1">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <ThicknessAnimation Storyboard.TargetName="MainGrid"
                                Storyboard.TargetProperty="Margin" 
                                From="0,50,0,0" To="0,0,0,0" Duration="0:0:1.5">
                <ThicknessAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut"/>
                </ThicknessAnimation.EasingFunction>
            </ThicknessAnimation>
        </Storyboard>
    </Window.Resources>
    <Grid x:Name="MainGrid" Opacity="1" Margin="0">
        <Grid.Triggers>
            <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                <BeginStoryboard Storyboard="{StaticResource Solid On Load}"/>
            </EventTrigger>
        </Grid.Triggers>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="80" />
            <ColumnDefinition Width="435" />
            <ColumnDefinition Width="1*" />
            <ColumnDefinition Width="140" />
        </Grid.ColumnDefinitions>

        <Rectangle Fill="{StaticResource AccentDark}"/>
        <StackPanel Margin="10 15 10 10">
            <!--ListIcon-->
            <Button Style="{StaticResource TaskManagerButton}" Margin="0 0 0 10" Background="{StaticResource AccentDark}">
                <Viewbox Width="35" Height="35">
                    <Path Data="{StaticResource ListIcon}" Fill="White"/>
                </Viewbox>
            </Button>

            <Button Style="{StaticResource TaskManagerButton}" Margin="0 0 0 20" Background="{StaticResource AccentDark}">
                <Viewbox Width="35" Height="35">
                    <Path Data="{StaticResource TickIcon}" Stroke="White" StrokeThickness="2.8"/>
                </Viewbox>
            </Button>

            <Button Style="{StaticResource TaskManagerButton}" Background="{StaticResource AccentDark}">
                <Viewbox Width="35" Height="35">
                    <Path Data="{StaticResource TimerIcon}" Fill="White"/>
                </Viewbox>
            </Button>
        </StackPanel>
        <Rectangle Fill="{StaticResource TaskListBackground}" Grid.Column="1"/>
        <!--Task List Grid-->

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="68" />
                <RowDefinition Height="50" />
                <RowDefinition Height="1*" />
            </Grid.RowDefinitions>

            <!-- Заголовок и кнопка -->
            <Label Style="{StaticResource Heading1}" Content="Задачи"/>
            <Button Style="{StaticResource RoundAccentButton}" 
            HorizontalAlignment="Right"
            VerticalAlignment="Center"
            Height="45"
            Width="45"
            Margin="0 0 20 0"
            Command="{Binding IOpenNewWindow}">
                <Viewbox Width="22.5" Height="22.5" 
                 VerticalAlignment="Center" 
                 HorizontalAlignment="Center">
                    <Path Data="{StaticResource NewTaskIcon}" 
                  Fill="{StaticResource OnAccent}"/>
                </Viewbox>
            </Button>

            <!-- Поиск -->
            <TextBox x:Name="TaskSearchBox"
             Style="{StaticResource TaskListSearchBox}" 
             Grid.Row="1"
             Margin="15 0"/>
            <Label IsHitTestVisible="False"
           Grid.Row="1" 
           Content="Поиск задач..."
           VerticalContentAlignment="Center"
           Margin="35 0 15 0"
           Foreground="{StaticResource Borders}"
           Visibility="{Binding Text.IsEmpty, ElementName=TaskSearchBox, Converter={StaticResource BooleanToVisibilityConverter}}"/>
            <Button Style="{StaticResource SearchButton}"
            Grid.Row="1"
            HorizontalAlignment="Right"
            VerticalAlignment="Center"
            Margin="0 0 40 0"
            Padding="7"
            Background="White"
            BorderBrush="Transparent"
            Height="40" 
            Width="40" Cursor="Hand">
                <Viewbox Width="16" Height="16" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Path Data="{StaticResource SearchIcon}" Fill="{StaticResource Borders}"/>
                </Viewbox>
            </Button>

            <!-- 👇 СПИСОК ЗАДАЧ ПОЛЬЗОВАТЕЛЯ -->
            <ListView x:Name="UserTasksListView"
                      ItemsSource="{Binding UserTasks}"
                      SelectedItem="{Binding SelectedTask}"
                      Grid.Row="2"
                      Margin="15"
                      Background="Gray"
                      BorderThickness="0"
                      HorizontalContentAlignment="Stretch">

                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Border CornerRadius="8" 
                                Margin="0 5" 
                                Background="{StaticResource MaterialDesignPaper}">
                            <Grid Margin="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <CheckBox VerticalAlignment="Center"
                          IsChecked="{Binding IsCompleted}"/>
                                <StackPanel Grid.Column="1" Margin="10 0">
                                    <TextBlock Text="{Binding Title}" 
                               FontWeight="SemiBold"
                               Foreground="{StaticResource Importance-Med}"/>
                                    <TextBlock Text="{Binding Description}"
                               TextWrapping="Wrap"
                               Foreground="{StaticResource Progress Late}"/>
                                </StackPanel>
                                <TextBlock Grid.Column="2"
                           Text="{Binding Deadline, StringFormat='{}{0:dd.MM.yyyy}'}"
                           Foreground="{StaticResource Progress Late}"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>
        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="1*"/>
                <RowDefinition Height="1*"/>
                <RowDefinition Height="66"/>
            </Grid.RowDefinitions>
            <Grid Margin="10 0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="60"/>
                    <RowDefinition Height="1*"/>
                    <RowDefinition Height="30"/>
                </Grid.RowDefinitions>
                <TextBlock Text="Название задачи"
                           Style="{StaticResource Title}"
                           VerticalAlignment="Center"/>
                <!--Importance Badge-->
                <Border HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        CornerRadius="5"
                        Background="{StaticResource Importance-Crit}"
                        Padding="20 5">
                    <TextBlock Text="Срочно"
                               Foreground="{StaticResource OnAccent}"
                               FontWeight="Bold"
                               FontSize="16"/>
                </Border>
                <!--Description-->
                <ScrollViewer Grid.Row="1"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <TextBlock Text="Краткое описание задачи."
                               FontSize="16"
                               Foreground="{StaticResource PlaceHolderText}"
                               Margin="20"/>
                </ScrollViewer>
                <TextBlock Text="Дата: 15/06/2026"
                           Background="{StaticResource AccentDark}"
                           Grid.Row="2"
                           Foreground="White"
                           Padding="20 3"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Left"/>
            </Grid>
            <!--Check List-->
            <Grid Grid.Row="1" Margin="0 20 0 0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="50"/>
                    <RowDefinition Height="1*"/>
                </Grid.RowDefinitions>

                <TextBlock Style="{StaticResource Title}"
               Text="Список выполненных задач"
               VerticalAlignment="Center"
               Margin="20 0 0 0"/>

                <ListView ItemsSource="{Binding CompletedTasks}"
              Background="Transparent"
              BorderThickness="0"
              Grid.Row="1">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Border CornerRadius="8" Margin="0 5" Background="#FFE8F5E9">
                                <Grid Margin="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <CheckBox VerticalAlignment="Center"
                                              IsChecked="{Binding IsCompleted}"
                                              Command="{Binding DataContext.ICompleteTask, RelativeSource={RelativeSource AncestorType=ListView}}"
                                              CommandParameter="{Binding}"/>
                                    <StackPanel Grid.Column="1" Margin="10 0">
                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding Description}" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
            <Grid Grid.Row="2">
                <Button Style="{StaticResource DeleteButton}"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        Content="Удалить"
                        Margin="8 0 0 0"
                        Command="{Binding IDeleteTask}"
                        CommandParameter="{Binding SelectedItem, ElementName=UserTasksListView}"/>
                <Button Style="{StaticResource EditButton}"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Command="{Binding IEditTask}"
                        CommandParameter="{Binding SelectedItem, ElementName=UserTasksListView}"
                        Content="Редактировать"/>
                <Button Style="{StaticResource ComplateButton}"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Command="{Binding ICompleteTask}"
                        CommandParameter="{Binding SelectedItem, ElementName=UserTasksListView}"
                        Content="Заврешить"/>
            </Grid>
        </Grid>
        <Rectangle Fill="{StaticResource TaskStatusBackground}" Grid.Column="3"/>


    </Grid>
</Window>