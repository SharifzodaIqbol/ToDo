<Window x:Class="TaskTurner.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:TaskTurner"
        xmlns:vm="clr-namespace:TaskTurner.ViewModels"
        mc:Ignorable="d"
        Title="MainWindow" Height="832" Width="1280"
        MinWidth="1150" MinHeight="500"
        WindowStartupLocation="CenterScreen">
    <Grid x:Name="MainGrid">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="80" />
            <ColumnDefinition Width="435" />
            <ColumnDefinition Width="1*" />
            <ColumnDefinition Width="240" />
        </Grid.ColumnDefinitions>

        <Rectangle Fill="{StaticResource AccentDark}"/>
        <Rectangle Fill="{StaticResource TaskListBackground}" Grid.Column="1"/>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="68" />
                <RowDefinition Height="50" />
                <RowDefinition Height="1*" />
            </Grid.RowDefinitions>

            <Label Style="{StaticResource Heading1}" Content="Задачи"/>
            <Button Style="{StaticResource RoundAccentButton}" 
            HorizontalAlignment="Right"
            VerticalAlignment="Center"
            Height="45"
            Width="45"
            Margin="0 0 20 0"
            Command="{Binding IOpenNewWindow}">
                <Viewbox Width="22.5" Height="22.5" 
                 VerticalAlignment="Center" 
                 HorizontalAlignment="Center">
                    <Path Data="{StaticResource NewTaskIcon}" 
                  Fill="{StaticResource OnAccent}"/>
                </Viewbox>
            </Button>

            <TextBox x:Name="TaskSearchBox"
                     Style="{StaticResource TaskListSearchBox}" 
                     Grid.Row="1"
                     Margin="15 0"
                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}">
                <TextBox.InputBindings>
                    <KeyBinding Key="Enter" Command="{Binding FilterTasksCommand}"/>
                </TextBox.InputBindings>
            </TextBox>
            <Label IsHitTestVisible="False"
                   Grid.Row="1" 
                   Content="Поиск задач..."
                   VerticalContentAlignment="Center"
                   Margin="25 0 15 0"
                   Foreground="{StaticResource Borders}"
                   Visibility="{Binding Text.IsEmpty, ElementName=TaskSearchBox, Converter={StaticResource BooleanToVisibilityConverter}}"/>
            <Button Style="{StaticResource SearchButton}"
                     Grid.Row="1"
                     HorizontalAlignment="Right"
                     VerticalAlignment="Center"
                     Margin="0 0 40 0"
                     Padding="7"
                     Background="White"
                     BorderBrush="Transparent"
                     Height="25" 
                     Width="25">
                <Viewbox Width="16" Height="16" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Path Data="{StaticResource SearchIcon}" Fill="{StaticResource Borders}"/>
                </Viewbox>
            </Button>
            <Button Style="{StaticResource SearchButton}"
                     Grid.Row="1"
                     HorizontalAlignment="Right"
                     VerticalAlignment="Center"
                     Margin="0 0 80 0"
                     Cursor="Hand"
                     Width="15" 
                     Height="15"
                     Command="{Binding ClearSearchCommand}">
                <Viewbox Stretch="Uniform">
                    <Path Data="{StaticResource CloseIcon}" Fill="{StaticResource Borders}" Height="15" Stretch="Fill" Width="16" />
                </Viewbox>
            </Button>
            <ListView x:Name="UserTasksListView"
                      ItemsSource="{Binding FilteredTasksView}"
                      SelectedItem="{Binding SelectedTask}"
                      Grid.Row="2"
                      Margin="15"
                      Background="#FFF5F7FA"
                      BorderThickness="0"
                      HorizontalContentAlignment="Stretch">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Border CornerRadius="8" 
                                Margin="0 5"
                                BorderBrush="#FFD1C4E9"
                                BorderThickness="1 1 1 4"
                                Background="#FFF3E5F5">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="15" ShadowDepth="1" Opacity="0.12" Color="#7B1FA2"/>
                            </Border.Effect>
                            <Grid Margin="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <CheckBox Grid.Row="0" Grid.Column="0"
                                          Cursor="Hand"
                                          VerticalAlignment="Center"
                                          IsChecked="{Binding IsCompleted, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          Command="{Binding DataContext.ICompleteTask, RelativeSource={RelativeSource AncestorType=ListView}}"
                                          CommandParameter="{Binding}"/>
                                <StackPanel Grid.Row="0" Grid.Column="1" Margin="10 0">
                                    <TextBlock Text="{Binding Title}"
                                               TextWrapping="Wrap"
                                               FontWeight="Bold"
                                               Foreground="#FF4A148C"
                                               FontSize="18"/>
                                    <TextBlock Text="{Binding Description}"
                                               TextWrapping="Wrap" 
                                               Foreground="#FF757575"
                                               FontSize="15"/>
                                </StackPanel>
                                <TextBlock Grid.Row="0" Grid.Column="3">
                                    <Run Text="Дата" Foreground="#888888" FontSize="10"/>
                                    <LineBreak/>
                                    <Run Text="{Binding CurrentDate, StringFormat='{}{0:dd.MM.yyyy}'}" FontSize="12"/>
                                    <LineBreak/>
                                    <Run Text="Время" Foreground="#888888" FontSize="10"/>
                                    <LineBreak/>
                                    <Run Text="{Binding CurrentDate, StringFormat='{}{0:HH:mm}'}" FontSize="12"/>
                                </TextBlock>
                                <TextBlock Grid.Row="0" Grid.Column="2" Text="{Binding TaskImportance}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource PriorityTextStyle}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding TaskImportance}" Value="Высокий">
                                                    <Setter Property="Foreground" Value="{StaticResource HighPriorityBrush}"/>
                                                    <Setter Property="FontWeight" Value="Bold"/>
                                                    <Setter Property="Margin" Value="0 0 10 0"/>
                                                    <Setter Property="VerticalAlignment" Value="Top"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding TaskImportance}" Value="Средний">
                                                    <Setter Property="Foreground" Value="{StaticResource MediumPriorityBrush}"/>
                                                    <Setter Property="FontWeight" Value="Bold"/>
                                                    <Setter Property="Margin" Value="0 0 10 0"/>
                                                    <Setter Property="VerticalAlignment" Value="Top"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding TaskImportance}" Value="Низкий">
                                                    <Setter Property="Foreground" Value="{StaticResource LowPriorityBrush}"/>
                                                    <Setter Property="FontWeight" Value="Bold"/>
                                                    <Setter Property="Margin" Value="0 0 10 0"/>
                                                    <Setter Property="VerticalAlignment" Value="Top"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding TaskImportance}" Value="Без приоритета">
                                                    <Setter Property="Foreground" Value="{StaticResource NoPriorityBrush}"/>
                                                    <Setter Property="FontWeight" Value="Bold"/>
                                                    <Setter Property="Margin" Value="0 0 10 0"/>
                                                    <Setter Property="VerticalAlignment" Value="Top"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>

                                <!-- Добавлены ProjectName и CategoryName -->
                                <StackPanel Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3" Orientation="Horizontal" Margin="10 5 0 0">
                                    <materialDesign:PackIcon Kind="Folder" Foreground="#FF673AB7" VerticalAlignment="Center" Margin="0 0 5 0"/>
                                    <TextBlock Text="{Binding ProjectName}" 
                                               Foreground="#FF673AB7" 
                                               FontSize="13" 
                                               FontWeight="SemiBold"
                                               VerticalAlignment="Center"/>
                                    <materialDesign:PackIcon Kind="Label" Foreground="#FF00BCD4" VerticalAlignment="Center" Margin="15 0 5 0"/>
                                    <TextBlock Text="{Binding CategoryName}" 
                                               Foreground="#FF00BCD4" 
                                               FontSize="13" 
                                               FontWeight="SemiBold"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>
        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="450"/>
                <RowDefinition Height="1*"/>
                <RowDefinition Height="10"/>
            </Grid.RowDefinitions>
            <Grid Margin="10 0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="80"/>
                    <RowDefinition Height="1*"/>
                    <RowDefinition Height="30"/>
                </Grid.RowDefinitions>
                <TextBlock Text="Список задач"
                           Style="{StaticResource Title}"
                           VerticalAlignment="Center"/>
                <ScrollViewer Grid.Row="1"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              Margin="0 0 0 15">
                    <ListView x:Name="NoFilterUserTasksListView"
                              ItemsSource="{Binding UserTasks}"
                              SelectedItem="{Binding SelectedTask}"
                              Grid.Row="2"
                              Margin="15"
                              Background="#FFF5F7FA"
                              BorderThickness="0"
                              HorizontalContentAlignment="Stretch">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Border CornerRadius="8" 
                                        Margin="0 5"
                                        BorderBrush="#FFD1C4E9"
                                        BorderThickness="1 1 1 4"
                                        Background="#FFF3E5F5">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="15" ShadowDepth="1" Opacity="0.12" Color="#7B1FA2"/>
                                    </Border.Effect>
                                    <Grid Margin="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <CheckBox Grid.Row="0" Grid.Column="0" Cursor="Hand"
                                                  VerticalAlignment="Center"
                                                  IsChecked="{Binding IsCompleted, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                  Command="{Binding DataContext.ICompleteTask, RelativeSource={RelativeSource AncestorType=ListView}}"
                                                  CommandParameter="{Binding}"/>
                                        <StackPanel Grid.Row="0" Grid.Column="1" Margin="10 0">
                                            <TextBlock Text="{Binding Title}" 
                                                       FontWeight="Bold"
                                                       TextWrapping="Wrap"
                                                       Foreground="#FF4A148C"
                                                       FontSize="18"/>
                                            <TextBlock Text="{Binding Description}"
                                                       TextWrapping="Wrap"
                                                       Foreground="#FF757575"
                                                       FontSize="15"/>
                                        </StackPanel>
                                        <TextBlock Grid.Row="0" Grid.Column="2" Text="{Binding TaskImportance}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource PriorityTextStyle}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding TaskImportance}" Value="Высокий">
                                                            <Setter Property="Foreground" Value="{StaticResource HighPriorityBrush}"/>
                                                            <Setter Property="FontWeight" Value="Bold"/>
                                                            <Setter Property="Margin" Value="0 0 10 0"/>
                                                            <Setter Property="VerticalAlignment" Value="Top"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding TaskImportance}" Value="Средний">
                                                            <Setter Property="Foreground" Value="{StaticResource MediumPriorityBrush}"/>
                                                            <Setter Property="FontWeight" Value="Bold"/>
                                                            <Setter Property="Margin" Value="0 0 10 0"/>
                                                            <Setter Property="VerticalAlignment" Value="Top"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding TaskImportance}" Value="Низкий">
                                                            <Setter Property="Foreground" Value="{StaticResource LowPriorityBrush}"/>
                                                            <Setter Property="FontWeight" Value="Bold"/>
                                                            <Setter Property="Margin" Value="0 0 10 0"/>
                                                            <Setter Property="VerticalAlignment" Value="Top"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding TaskImportance}" Value="Без приоритета">
                                                            <Setter Property="Foreground" Value="{StaticResource NoPriorityBrush}"/>
                                                            <Setter Property="FontWeight" Value="Bold"/>
                                                            <Setter Property="Margin" Value="0 0 10 0"/>
                                                            <Setter Property="VerticalAlignment" Value="Top"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBlock Grid.Row="0" Grid.Column="3">
                                            <Run Text="Дата" Foreground="#888888" FontSize="10"/>
                                            <LineBreak/>
                                            <Run Text="{Binding CurrentDate, StringFormat='{}{0:dd.MM.yyyy}'}" FontSize="12"/>
                                            <LineBreak/>
                                            <Run Text="Время" Foreground="#888888" FontSize="10"/>
                                            <LineBreak/>
                                            <Run Text="{Binding CurrentDate, StringFormat='{}{0:HH:mm}'}" FontSize="12"/>
                                        </TextBlock>

                                        <!-- Добавлены ProjectName и CategoryName -->
                                        <StackPanel Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3" Orientation="Horizontal" Margin="10 5 0 0">
                                            <materialDesign:PackIcon Kind="Folder" Foreground="#FF673AB7" VerticalAlignment="Center" Margin="0 0 5 0"/>
                                            <TextBlock Text="{Binding ProjectName}" 
                                                       Foreground="#FF673AB7" 
                                                       FontSize="13" 
                                                       FontWeight="SemiBold"
                                                       VerticalAlignment="Center"/>
                                            <materialDesign:PackIcon Kind="Label" Foreground="#FF00BCD4" VerticalAlignment="Center" Margin="15 0 5 0"/>
                                            <TextBlock Text="{Binding CategoryName}" 
                                                       Foreground="#FF00BCD4" 
                                                       FontSize="13" 
                                                       FontWeight="SemiBold"
                                                       VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </ScrollViewer>
                <Grid Grid.Row="2">
                    <Button Style="{StaticResource DeleteButton}"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            Content="Удалить"
                            Margin="80 0 0 0"
                            Command="{Binding IDeleteTask}"
                            CommandParameter="{Binding SelectedTask}"/>

                    <Button Style="{StaticResource EditButton}"
                            HorizontalAlignment="Right"
                            Margin="0 0 80 0"
                            VerticalAlignment="Center"
                            Command="{Binding IEditTask}"
                            CommandParameter="{Binding SelectedTask}"
                            Content="Редактировать"/>
                </Grid>
            </Grid>
            <Grid Grid.Row="1" Margin="0 10 0 0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="50"/>
                    <RowDefinition Height="1*"/>
                </Grid.RowDefinitions>
                <TextBlock Style="{StaticResource Title}"
                           Text="Список выполненных задач"
                           VerticalAlignment="Center"
                           Margin="10 5 0 0"/>

                <ListView ItemsSource="{Binding CompletedTasks}"
                          Background="Transparent"
                          Grid.Row="1"
                          Margin="25 0 0 0"
                          ScrollViewer.VerticalScrollBarVisibility="Auto">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Border CornerRadius="8"
                                    Margin="0 5"
                                    Background="#FFF1F8E9"
                                    BorderBrush="#FFC8E6C9"
                                    BorderThickness="1 1 1 4">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="15" ShadowDepth="2" Opacity="0.12" Color="#FF4CAF50"/>
                                </Border.Effect>

                                <Grid Margin="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <CheckBox Grid.Row="0" Grid.Column="0"
                                              Cursor="Hand"
                                              VerticalAlignment="Center"
                                              IsChecked="{Binding IsCompleted, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                              Command="{Binding DataContext.ICompleteTask, RelativeSource={RelativeSource AncestorType=ListView}}"
                                              CommandParameter="{Binding}"
                                              Style="{StaticResource MaterialDesignCheckBox}"
                                              Foreground="#FF4CAF50"/>
                                    <StackPanel Grid.Row="0" Grid.Column="1" Margin="10 0">
                                        <TextBlock Text="{Binding Title}"
                                                   FontWeight="Bold"
                                                   TextWrapping="Wrap"
                                                   Foreground="#FF2E7D32"
                                                   FontSize="18"
                                                   TextDecorations="Strikethrough"
                                                   VerticalAlignment="Center"
                                                   Margin="0 0 10 0"/>
                                        <TextBlock Text="{Binding Description}"
                                                   TextWrapping="Wrap"
                                                   Foreground="#FF81C784"
                                                   FontStyle="Italic"
                                                   FontSize="15"
                                                   TextDecorations="Strikethrough"
                                                   Margin="0 5 0 0"/>
                                        <TextBlock Text="Выполнено:"
                                                   Foreground="#FFA5D6A7"
                                                   FontSize="13"
                                                   Margin="0 5 0 0"/>
                                    </StackPanel>
                                    <TextBlock Grid.Row="0" Grid.Column="2" Text="{Binding TaskImportance}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource PriorityTextStyle}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding TaskImportance}" Value="Высокий">
                                                        <Setter Property="Foreground" Value="{StaticResource HighPriorityBrush}"/>
                                                        <Setter Property="FontWeight" Value="Bold"/>
                                                        <Setter Property="Margin" Value="0 0 10 0"/>
                                                        <Setter Property="VerticalAlignment" Value="Top"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding TaskImportance}" Value="Средний">
                                                        <Setter Property="Foreground" Value="{StaticResource MediumPriorityBrush}"/>
                                                        <Setter Property="FontWeight" Value="Bold"/>
                                                        <Setter Property="Margin" Value="0 0 10 0"/>
                                                        <Setter Property="VerticalAlignment" Value="Top"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding TaskImportance}" Value="Низкий">
                                                        <Setter Property="Foreground" Value="{StaticResource LowPriorityBrush}"/>
                                                        <Setter Property="FontWeight" Value="Bold"/>
                                                        <Setter Property="Margin" Value="0 0 10 0"/>
                                                        <Setter Property="VerticalAlignment" Value="Top"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding TaskImportance}" Value="Без приоритета">
                                                        <Setter Property="Foreground" Value="{StaticResource NoPriorityBrush}"/>
                                                        <Setter Property="FontWeight" Value="Bold"/>
                                                        <Setter Property="Margin" Value="0 0 10 0"/>
                                                        <Setter Property="VerticalAlignment" Value="Top"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBlock Grid.Row="0" Grid.Column="3">
                                        <Run Text="Дата" Foreground="#888888" FontSize="10"/>
                                        <LineBreak/>
                                        <Run Text="{Binding CurrentDate, StringFormat='{}{0:dd.MM.yyyy}'}" FontSize="12"/>
                                        <LineBreak/>
                                        <Run Text="Время" Foreground="#888888" FontSize="10"/>
                                        <LineBreak/>
                                        <Run Text="{Binding CurrentDate, StringFormat='{}{0:HH:mm}'}" FontSize="12"/>
                                    </TextBlock>

                                    <!-- Добавлены ProjectName и CategoryName для выполненных задач -->
                                    <StackPanel Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3" Orientation="Horizontal" Margin="10 5 0 0">
                                        <materialDesign:PackIcon Kind="Folder" Foreground="#FF4CAF50" VerticalAlignment="Center" Margin="0 0 5 0"/>
                                        <TextBlock Text="{Binding ProjectName}" 
                                                   Foreground="#FF4CAF50" 
                                                   FontSize="13" 
                                                   FontWeight="SemiBold"
                                                   VerticalAlignment="Center"/>
                                        <materialDesign:PackIcon Kind="Label" Foreground="#FF8BC34A" VerticalAlignment="Center" Margin="15 0 5 0"/>
                                        <TextBlock Text="{Binding CategoryName}" 
                                                   Foreground="#FF8BC34A" 
                                                   FontSize="13" 
                                                   FontWeight="SemiBold"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </Grid>

        <Grid Grid.Column="3" Background="{StaticResource TaskStatusBackground}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="15">
                    <Label Content="Новый проект" Style="{StaticResource Heading1}" HorizontalAlignment="Center" FontSize="16"/>
                    <TextBox Text="{Binding NewProjectName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource TaskListSearchBox}" Margin="0 5 0 0"/>
                    <Button Content="Добавить проект" HorizontalAlignment="Center" Command="{Binding AddProjectCommand}" Style="{StaticResource EditButton}" Margin="0 10 0 20"/>

                    <Label Content="Новая категория" Style="{StaticResource Heading1}" HorizontalAlignment="Center" FontSize="16"/>
                    <TextBox Text="{Binding NewCategoryName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource TaskListSearchBox}" Margin="0 5 0 0"/>
                    <Button Content="Добавить категорию" HorizontalAlignment="Center" Command="{Binding AddCategoryCommand}" Style="{StaticResource EditButton}" Margin="0 10 0 20"/>

                    <Label Content="Новый тег" Style="{StaticResource Heading1}" HorizontalAlignment="Center" FontSize="16"/>
                    <TextBox Text="{Binding NewTagName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource TaskListSearchBox}" Margin="0 5 0 0"/>
                    <Button Content="Добавить тег" HorizontalAlignment="Center" Command="{Binding AddTagCommand}" Style="{StaticResource EditButton}" Margin="0 10 0 0"/>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>
