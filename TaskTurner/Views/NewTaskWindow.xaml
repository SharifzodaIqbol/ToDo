<Window x:Class="TaskTurner.Views.NewTaskWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        mc:Ignorable="d"
        Title="Добавить задачу" Height="400" Width="400" Background="{StaticResource TaskStatusBackground}">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBox x:Name="TaskTitleBox"
                 Grid.Row="1"
                 Style="{StaticResource MaterialDesignOutlinedTextBox}"
                 materialDesign:HintAssist.Hint="Введите название задачи"
                 materialDesign:TextFieldAssist.UnderlineBrush="#FF3CC641"
                 materialDesign:HintAssist.Foreground="Gray"
                 SelectionBrush="LightGreen"
                 Foreground="{StaticResource TaskListTitle}"
                 Margin="0,0,0,15"/>
        <Grid Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="1*"/>
                <RowDefinition Height="1*"/>
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="3" 
                   Text="Выберите приоритет задачи"
                   Style="{StaticResource Title}"
                   FontSize="15"
                   Margin="10 15"/>
            <StackPanel Grid.Row="2">
                <ComboBox x:Name="ImportanceBox"
                          SelectedValuePath="Tag"
                          Margin="10 50"
                          Width="200"
                          HorizontalAlignment="Left"
                          SelectedIndex="3">
                    <!-- Высокий приоритет -->
                    <StackPanel Orientation="Horizontal" Tag="Высокий">
                        <materialDesign:PackIcon 
                                Kind="AlertCircle" 
                                Style="{StaticResource PriorityIconStyle}"
                                Foreground="{StaticResource HighPriorityBrush}"/>
                        <TextBlock Text="Высокий" 
                                Style="{StaticResource HighPriorityStyle}"/>
                    </StackPanel>
                        <!-- Средний приоритет -->
                    <StackPanel Orientation="Horizontal" Tag="Средний">
                        <materialDesign:PackIcon 
                                Kind="Alert" 
                                Style="{StaticResource PriorityIconStyle}"
                                Foreground="{StaticResource MediumPriorityBrush}"/>
                        <TextBlock 
                                Text="Средний" 
                                Style="{StaticResource MediumPriorityStyle}"/>
                    </StackPanel>
                        <!-- Низкий приоритет -->
                    <StackPanel Orientation="Horizontal" Tag="Низкий">
                        <materialDesign:PackIcon 
                                Kind="Alert" 
                                Style="{StaticResource PriorityIconStyle}"
                                Foreground="{StaticResource LowPriorityBrush}"/>
                        <TextBlock 
                                Text="Низкий" 
                                Style="{StaticResource MediumPriorityStyle}"/>
                        </StackPanel>

                        <!-- Без приоритета -->
                    <StackPanel Orientation="Horizontal" Tag="Без приоритета">
                        <materialDesign:PackIcon 
                                Kind="Alert" 
                                Style="{StaticResource PriorityIconStyle}"
                                Foreground="{StaticResource NoPriorityBrush}"/>
                        <TextBlock 
                                Text="Без приоритета" 
                                Style="{StaticResource NoPriorityStyle}"/>
                    </StackPanel>
                </ComboBox>
            </StackPanel>
            <TextBox x:Name="TaskDescriptionBox"
                     Grid.Row="1"
                     AcceptsReturn="True"
                     TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto"
                     Style="{StaticResource MaterialDesignOutlinedTextBox}"
                     materialDesign:HintAssist.Hint="Введите описание задачи"
                     materialDesign:HintAssist.Foreground="Gray"
                     materialDesign:TextFieldAssist.UnderlineBrush="#FF3CC641"
                     SelectionBrush="LightGreen"
                     VerticalContentAlignment="Top"
                     HorizontalContentAlignment="Left"
                     Foreground="{StaticResource TaskListTitle}"/>
        </Grid>
        <Button Content="Добавить" 
                Grid.Row="3"
                HorizontalAlignment="Right"
                Width="100"
                Margin="0,15,2,0"
                Background="#FF3CC641"
                Foreground="White"
                Cursor="Hand"
                Click="CreateTask_Click"
                Style="{StaticResource MaterialDesignRaisedButton}"/>
    </Grid>
</Window>