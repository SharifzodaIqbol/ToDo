<Window x:Class="TaskTurner.RegistrationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Регистрация"
        Height="400" Width="350"
        MinHeight="350" MaxHeight="450"
        MinWidth="300" MaxWidth="400"
        Background="#FF263238"
        WindowStartupLocation="CenterScreen">

    <Grid Margin="20">
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="250" >

            <TextBlock Text="Регистрация"
                       Foreground="White"
                       FontWeight="Bold"
                       FontSize="22"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,30"/>

            <TextBox x:Name="usernameBox"
                     materialDesign:HintAssist.Hint="Имя пользователя"
                     Style="{StaticResource MaterialDesignTextBox}"
                     Foreground="White"
                     CaretBrush="White"
                     SelectionBrush="White"
                     BorderBrush="White"
                     Margin="0,0,0,20"/>

            <PasswordBox x:Name="passwordBox"
                         PasswordChar="*"
                         materialDesign:HintAssist.Hint="Пароль"
                         Style="{StaticResource MaterialDesignRevealPasswordBox}" 
                         Foreground="White"
                         SelectionBrush="White"
                         BorderBrush="White"
                         Margin="0,0,0,20"/>

            <PasswordBox x:Name="repeat_passwordBox"
                         materialDesign:HintAssist.Hint="Подтвердите пароль"
                         PasswordChar="*"
                         Style="{StaticResource MaterialDesignRevealPasswordBox}" 
                         Foreground="White"
                         SelectionBrush="White"
                         BorderBrush="White"
                         Margin="0,0,0,30"/>

            <Button Content="Зарегистрироваться"
                    Style="{StaticResource MaterialDesignRaisedButton}"
                    Background="#4CAF50"
                    Foreground="White"
                    FontWeight="SemiBold"
                    Width="170"
                    Click="RegisterButton_Click"
                    HorizontalAlignment="Center"
                    materialDesign:ButtonAssist.CornerRadius="8"/>
        </StackPanel>
    </Grid>
</Window>
