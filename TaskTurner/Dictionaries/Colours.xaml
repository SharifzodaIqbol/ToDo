<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <SolidColorBrush x:Key="AccentDark" Color="#FF164863"/>
    <SolidColorBrush x:Key="AccentDarkOver" Color="#FF164863"/>
    <SolidColorBrush x:Key="AccentDarkClick" Color="#FF5097BD"/>
    <SolidColorBrush x:Key="TaskListBackground" Color="#FFECECEC"/>
    <SolidColorBrush x:Key="WindowBackground" Color="#FFFFFFFF"/>
    <SolidColorBrush x:Key="TaskStatusBackground" Color="#FFF6F6F6"/>

    <!--OnAccent-->
    <SolidColorBrush x:Key="OnAccent" Color="#FFFFFFFF"/>

    <SolidColorBrush x:Key="Borders" Color="#FFC9B5B5"/>
    
    <SolidColorBrush x:Key="PlaceHolderText" Color="#FFD4D4D4"/>
    <SolidColorBrush x:Key="PlaceHolderBorder" Color="#FF958888"/>

    <SolidColorBrush x:Key="Button-Complate" Color="#FF2AD985"/>
    <SolidColorBrush x:Key="Button-Complate-Over" Color="#FF65C295"/>
    <SolidColorBrush x:Key="Button-Complate-Click" Color="#FF6BA98B"/>
    <SolidColorBrush x:Key="Button-Edit" Color="#FFF4830C"/>
    <SolidColorBrush x:Key="Button-Edit-Over" Color="#FFD19353"/>
    <SolidColorBrush x:Key="Button-Edit-Click" Color="#FFBA9166"/>
    <SolidColorBrush x:Key="Button-Delete" Color="#FFCA2C2C"/>
    <SolidColorBrush x:Key="Button-Delete-Over" Color="#FFDA5A5A"/>
    <SolidColorBrush x:Key="Button-Delete-Click" Color="#FFAE5151"/>
    <!--Task Progress-->
    <SolidColorBrush x:Key="Progress InProgress" Color="#FF518657"/>
    <SolidColorBrush x:Key="Progress Completed" Color="#FF4187AC"/>
    <SolidColorBrush x:Key="Progress NotStarted" Color="#FFB1B1B1"/>
    <SolidColorBrush x:Key="Progress Late" Color="#FF846161"/>
    <SolidColorBrush x:Key="Progress Archived" Color="#FFCBA36C"/>
    <SolidColorBrush x:Key="Progress Deleted" Color="#FF606060"/>
    
    <!--Left Panel-->
    <SolidColorBrush x:Key="Nav.Default" Color="Transparent"/>
    <SolidColorBrush x:Key="Nav.Over" Color="#FFBCD5E2"/>
    <SolidColorBrush x:Key="Nav.Click" Color="#FF551F98"/>
    <SolidColorBrush x:Key="HighPriorityBrush" Color="#FF5252"/>
    <!-- Red 600 -->
    <SolidColorBrush x:Key="MediumPriorityBrush" Color="#FF9100"/>
    <!-- Orange 800 -->
    <SolidColorBrush x:Key="LowPriorityBrush" Color="#388E3C"/>
    <!-- Green 700 -->
    <SolidColorBrush x:Key="NoPriorityBrush" Color="#616161"/>
    <SolidColorBrush x:Key="TaskListDescriptionUserText" Color="#FF8C8892"/>
    <SolidColorBrush x:Key="TaskListTitle" Color="#FF6F6A76"/>
    
</ResourceDictionary>